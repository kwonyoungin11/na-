<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="동국문화재연구원 낙찰분석프로그램"
    Manufacturer="동국문화재연구원"
    Version="1.0.1"
    UpgradeCode="{A4C6E3F1-7A34-4D52-9AF8-1D2C5D8B7C90}"
    Language="1042"
    Scope="perMachine"
    InstallerVersion="500">

    <SummaryInformation Description="동국문화재연구원 낙찰분석프로그램 설치 패키지" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <MajorUpgrade DowngradeErrorMessage="더 최신 버전이 이미 설치되어 있습니다." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DonggukBidAnalyzer" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="동국문화재연구원 낙찰분석프로그램" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Feature
      Id="MainFeature"
      Title="동국문화재연구원 낙찰분석프로그램"
      Description="낙찰 데이터 분석용 데스크톱 프로그램"
      Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ShortcutComponents">
      <Component Id="StartMenuShortcutComponent" Directory="ProgramMenuDir" Guid="*">
        <Shortcut
          Id="StartMenuShortcut"
          Name="동국문화재연구원 낙찰분석프로그램"
          Target="[INSTALLFOLDER]동국문화재연구원_낙찰분석프로그램.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="ProgramMenuDirOnUninstall" Directory="ProgramMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\DonggukBidAnalyzer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="*">
        <Shortcut
          Id="DesktopShortcut"
          Name="동국문화재연구원 낙찰분석프로그램"
          Target="[INSTALLFOLDER]동국문화재연구원_낙찰분석프로그램.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\DonggukBidAnalyzer" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
