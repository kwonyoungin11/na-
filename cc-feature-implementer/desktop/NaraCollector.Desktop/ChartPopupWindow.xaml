<Window x:Class="NaraCollector.Desktop.ChartPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:NaraCollector.Desktop.Controls"
        mc:Ignorable="d"
        Title="동국문화재연구원 낙찰분석프로그램 - 분석 창"
        Width="1920"
        Height="1080"
        MinWidth="1320"
        MinHeight="820"
        WindowState="Maximized"
        Background="{StaticResource Bg0Brush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="8" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0"
                                         To="1"
                                         Duration="0:0:0.25" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
                <RowDefinition Height="148" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                <TabControl Margin="0">
                    <TabItem Header="전장 맵">
                        <Grid Margin="4">
                            <Border Style="{StaticResource CardBorderStyle}" Padding="8">
                                <controls:NativeBidChartControl
                                    Participants="{Binding CurrentParticipants}"
                                    SelectedCompany="{Binding SelectedCompany}"
                                    MinAdjustRate="{Binding SelectedMinAdjustRate}"
                                    MaxAdjustRate="{Binding SelectedMaxAdjustRate}"
                                    Precision="{Binding SelectedChartPrecision}"
                                    Mode="Scatter"
                                    CompanyPicked="ChartCompanyPicked"
                                    HoveredRateChanged="ChartHoveredRateChanged"
                                    RateRangeSelected="ChartRateRangeSelected" />
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="패턴 비교">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="8">
                                <controls:NativeBidChartControl
                                    Participants="{Binding CurrentParticipants}"
                                    SelectedCompany="{Binding SelectedCompany}"
                                    MinAdjustRate="{Binding SelectedMinAdjustRate}"
                                    MaxAdjustRate="{Binding SelectedMaxAdjustRate}"
                                    Precision="{Binding SelectedChartPrecision}"
                                    Mode="Trend"
                                    CompanyPicked="ChartCompanyPicked"
                                    RateRangeSelected="ChartRateRangeSelected" />
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="8">
                                <controls:NativeBidChartControl
                                    Participants="{Binding CurrentParticipants}"
                                    SelectedCompany="{Binding SelectedCompany}"
                                    MinAdjustRate="{Binding SelectedMinAdjustRate}"
                                    MaxAdjustRate="{Binding SelectedMaxAdjustRate}"
                                    Precision="{Binding SelectedChartPrecision}"
                                    Mode="Distribution"
                                    CompanyPicked="ChartCompanyPicked"
                                    RateRangeSelected="ChartRateRangeSelected" />
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="실행 근거">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.1*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleTextStyle}" Text="실시간 공고 리스트" />
                                    <DataGrid Grid.Row="1"
                                              Margin="0,10,0,0"
                                              ItemsSource="{Binding NoticeItems}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              EnableRowVirtualization="True"
                                              EnableColumnVirtualization="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="공고번호" Binding="{Binding NoticeNumber}" Width="1.1*" />
                                            <DataGridTextColumn Header="공고명" Binding="{Binding NoticeName}" Width="2.1*" />
                                            <DataGridTextColumn Header="발주처" Binding="{Binding OrderingAgency}" Width="0.95*" />
                                            <DataGridTextColumn Header="개찰일시" Binding="{Binding OpenDate, StringFormat=yyyy-MM-dd HH:mm}" Width="0.95*" />
                                            <DataGridTextColumn Header="사정률" Binding="{Binding AdjustRate, StringFormat=F5}" Width="0.75*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleTextStyle}" Text="이벤트 피드" />
                                    <ListBox Grid.Row="1"
                                             Margin="0,10,0,0"
                                             ItemsSource="{Binding LoadEvents}"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling" />
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <Grid Grid.Row="2" Margin="0,-72,0,0">
                <Border Background="Transparent" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="272" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}" Text="기간" />
                                <ComboBox Width="128"
                                          ItemsSource="{Binding PeriodPresets}"
                                          SelectedItem="{Binding SelectedPeriodPreset}"
                                          SelectionChanged="GlobalFilterSelectionChanged" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}" Text="정밀도" />
                                <ComboBox Width="84"
                                          ItemsSource="{Binding ChartPrecisionOptions}"
                                          SelectedItem="{Binding SelectedChartPrecision}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}" Text="최소" />
                                <ComboBox Width="84"
                                          ItemsSource="{Binding AdjustRateRangeOptions}"
                                          SelectedItem="{Binding SelectedMinAdjustRate}"
                                          SelectionChanged="GlobalFilterSelectionChanged" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1">
                                <TextBlock Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}" Text="최대" />
                                <ComboBox Width="84"
                                          ItemsSource="{Binding AdjustRateRangeOptions}"
                                          SelectedItem="{Binding SelectedMaxAdjustRate}"
                                          SelectionChanged="GlobalFilterSelectionChanged" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0,0,0,2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button MinWidth="52"
                                        Padding="8,2"
                                        FontSize="11"
                                        Click="ResetCompanySelectionClicked"
                                        Content="전체" />
                            </StackPanel>

                            <Border Grid.Row="1"
                                    BorderBrush="{StaticResource StrokeSubtleBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource Bg1Brush}"
                                    Padding="6,2,6,6"
                                    ClipToBounds="True">
                                <ItemsControl ItemsSource="{Binding CompanyCheckItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="5" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="58"
                                                    Margin="1,1,3,1"
                                                    Background="Transparent"
                                                    ClipToBounds="True">
                                                <CheckBox ToolTip="{Binding Name}"
                                                          HorizontalAlignment="Stretch"
                                                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox" BasedOn="{StaticResource ListCheckBoxStyle}">
                                                            <Setter Property="FontSize" Value="8.5" />
                                                            <Setter Property="Padding" Value="0" />
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                    <CheckBox.Content>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Width="34"
                                                                   FontSize="8"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </CheckBox.Content>
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
