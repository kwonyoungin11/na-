<Window x:Class="NaraCollector.Desktop.ChartPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:NaraCollector.Desktop.Controls"
        mc:Ignorable="d"
        Title="동국문화유산연구원 낙찰분석프로그램 - 분석 창"
        Width="1920"
        Height="1080"
        MinWidth="1320"
        MinHeight="820"
        WindowState="Maximized"
        Background="{StaticResource GlassWindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource BodyFont}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource AccentGradientBrush}" />
    <Grid Grid.Row="1" Margin="16,12,16,14" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0"
                                         To="1"
                                         Duration="0:0:0.25" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="10">
                <Grid Margin="2">
                    <controls:NativeBidChartControl
                        x:Name="ScatterMap"
                        Participants="{Binding CurrentParticipants}"
                        SelectedCompany="{Binding SelectedCompany}"
                        StartDate="{Binding StartDate}"
                        EndDate="{Binding EndDate}"
                        MinAdjustRate="{Binding SelectedMinAdjustRate}"
                        MaxAdjustRate="{Binding SelectedMaxAdjustRate}"
                        PinnedRecommendationBandMin="{Binding RecommendationBandMin}"
                        PinnedRecommendationBandMax="{Binding RecommendationBandMax}"
                        PinnedRecommendationText="{Binding ConsolePipelineRecommendationText}"
                        Precision="{Binding SelectedChartPrecision}"
                        Mode="Scatter"
                        HighPerformanceMode="True"
                        CompanyPicked="ChartCompanyPicked"
                        HoveredRateChanged="ChartHoveredRateChanged"
                        RateRangeSelected="ChartRateRangeSelected" />
                    <Border Style="{StaticResource MapToolbarBorderStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,12,14,0"
                            Panel.ZIndex="2">
                        <Button Height="40"
                                Style="{StaticResource MapResetButtonStyle}"
                                Content="맵 초기화"
                                Click="ResetMapClick"
                                ToolTip="확대·이동을 해제하고 전장 맵을 중앙에 맞춥니다."
                                AutomationProperties.Name="맵 초기화"
                                AutomationProperties.HelpText="확대와 이동을 해제하고 전장 맵을 가운데로 맞춥니다." />
                    </Border>
                </Grid>
            </Border>

            <TabControl x:Name="AnalysisSideTabs"
                        Grid.Column="2"
                        Style="{StaticResource AnalysisTabControlStyle}">
                <TabItem Header="좌측선점">
                    <Border Style="{StaticResource AnalysisPaneBorderStyle}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top"
                                       Style="{StaticResource MutedCaptionTextStyle}"
                                       Margin="0,0,0,8"
                                       Text="충돌앵커 왼쪽 · 전장 맵과 같은 스냅샷" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="LeftOccupyBoard"
                                              ItemsSource="{Binding LeftOccupyZones}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="10,8"
                                                    CornerRadius="10"
                                                    BorderThickness="1"
                                                    BorderBrush="{StaticResource StrokeSubtleBrush}"
                                                    Background="#FFFFFF">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Style="{StaticResource MutedCaptionTextStyle}"
                                                                   Text="{Binding UncertaintyLabel, StringFormat='불확실성 {0}'}" />
                                                        <TextBlock Style="{StaticResource EyebrowTextStyle}"
                                                                   Text="{Binding CategoryLabel}" />
                                                    </DockPanel>
                                                    <TextBlock Margin="0,6,0,0"
                                                               TextWrapping="Wrap"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               Text="{Binding Summary}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </TabItem>
            </TabControl>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,10,0,0"
                    Style="{StaticResource AnalysisFilterDockStyle}"
                    Padding="14,12">
                <Grid MinHeight="168">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="2"
                                   Style="{StaticResource EyebrowTextStyle}"
                                   Margin="0,0,0,8"
                                   Text="분석 범위" />

                        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top"
                                       Style="{StaticResource MutedCaptionTextStyle}"
                                       Margin="0,0,0,4"
                                       Text="기간" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding PeriodPresets}"
                                      SelectedItem="{Binding SelectedPeriodPreset}"
                                      SelectionChanged="GlobalFilterSelectionChanged" />
                        </DockPanel>
                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top"
                                       Style="{StaticResource MutedCaptionTextStyle}"
                                       Margin="0,0,0,4"
                                       Text="정밀도" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding ChartPrecisionOptions}"
                                      SelectedItem="{Binding SelectedChartPrecision}" />
                        </DockPanel>
                        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,8" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top"
                                       Style="{StaticResource MutedCaptionTextStyle}"
                                       Margin="0,0,0,4"
                                       Text="지역" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding RegionOptions}"
                                      SelectedItem="{Binding SelectedRegion}"
                                      SelectionChanged="GlobalFilterSelectionChanged" />
                        </DockPanel>
                        <DockPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,0" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top"
                                       Style="{StaticResource MutedCaptionTextStyle}"
                                       Margin="0,0,0,4"
                                       Text="최소" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding AdjustRateRangeOptions}"
                                      SelectedItem="{Binding SelectedMinAdjustRate}"
                                      SelectionChanged="GlobalFilterSelectionChanged" />
                        </DockPanel>
                        <DockPanel Grid.Row="4" Grid.Column="1" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top"
                                       Style="{StaticResource MutedCaptionTextStyle}"
                                       Margin="0,0,0,4"
                                       Text="최대" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding AdjustRateRangeOptions}"
                                      SelectedItem="{Binding SelectedMaxAdjustRate}"
                                      SelectionChanged="GlobalFilterSelectionChanged" />
                        </DockPanel>
                    </Grid>

                    <Border Grid.Column="2"
                            Width="1"
                            Margin="0,6"
                            Background="{StaticResource StrokeSubtleBrush}" />

                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource EyebrowTextStyle}"
                                       VerticalAlignment="Center"
                                       Text="업체" />
                            <Button HorizontalAlignment="Right"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinHeight="32"
                                    Height="32"
                                    MinWidth="64"
                                    Padding="12,0"
                                    Margin="0"
                                    Click="ResetCompanySelectionClicked"
                                    Content="전체"
                                    ToolTip="선택한 업체를 모두 켭니다."
                                    AutomationProperties.Name="업체 전체 선택" />
                        </Grid>

                        <Border Grid.Row="1"
                                MinHeight="128"
                                BorderBrush="{StaticResource StrokeSubtleBrush}"
                                BorderThickness="1"
                                Background="{StaticResource Bg1Brush}"
                                CornerRadius="12"
                                Padding="8,6"
                                ClipToBounds="True">
                            <ItemsControl ItemsSource="{Binding CompanyCheckItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="5" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="1,1,6,1"
                                                Background="Transparent"
                                                ClipToBounds="True">
                                            <CheckBox ToolTip="{Binding Name}"
                                                      HorizontalAlignment="Stretch"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource ListCheckBoxStyle}">
                                                        <Setter Property="FontSize" Value="11" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                                <CheckBox.Content>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                </CheckBox.Content>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Grid>
</Window>
