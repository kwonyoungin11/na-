<Window x:Class="NaraCollector.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:NaraCollector.Desktop.Controls"
        mc:Ignorable="d"
        Title="동국문화유산연구원 낙찰분석프로그램"
        Width="1880"
        Height="1060"
        MinWidth="1420"
        MinHeight="900"
        Background="{StaticResource GlassWindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <LinearGradientBrush x:Key="GlassWindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EAF8FBFD" Offset="0" />
            <GradientStop Color="#DFF2F6FA" Offset="0.55" />
            <GradientStop Color="#D6EEF3F8" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassCardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D6FFFFFF" Offset="0" />
            <GradientStop Color="#C4FFFFFF" Offset="0.55" />
            <GradientStop Color="#B8F6F8FB" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassHeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#DAFFFFFF" Offset="0" />
            <GradientStop Color="#CCFFFFFF" Offset="0.55" />
            <GradientStop Color="#BEEFF4F8" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PreviewFrameBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#C97749" Offset="0" />
            <GradientStop Color="#D3885F" Offset="0.58" />
            <GradientStop Color="#DE976E" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="PreviewCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Background" Value="{StaticResource GlassCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PreviewFrameBrush}" />
            <Setter Property="BorderThickness" Value="1.35" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="30" Color="#081018" ShadowDepth="10" Opacity="0.10" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreviewHeroBorderStyle" TargetType="Border" BasedOn="{StaticResource HeroCardBorderStyle}">
            <Setter Property="Background" Value="{StaticResource GlassHeroBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PreviewFrameBrush}" />
            <Setter Property="BorderThickness" Value="1.35" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="34" Color="#081018" ShadowDepth="12" Opacity="0.12" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0"
                                         To="1"
                                         Duration="0:0:0.30" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PreviewHeroBorderStyle}"
                Padding="14">
            <Border BorderBrush="{StaticResource PreviewFrameBrush}"
                    BorderThickness="1.3"
                    Background="{StaticResource GlassHeroBackgroundBrush}"
                    CornerRadius="6"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="2,0,0,0">
                        <TextBlock Margin="0,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"
                                   Text="동국문화유산연구원" />
                    </StackPanel>

                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource PreviewFrameBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="#A6FFFFFF"
                            Padding="8">
                        <controls:TrendLineChartControl x:Name="NoticeTrendChart"
                                                        ItemsSource="{Binding NoticeAdjustRateTrendPoints}"
                                                        SecondaryItemsSource="{Binding NoticeAwardReferenceTrendPoints}"
                                                        Height="250"
                                                        FooterCaption="동국 기초대비사정율"
                                                        PrimaryLegendText="동국문화재연구원 기초대비사정율"
                                                        SecondaryLegendText="같은 공고 실제 낙찰 사정율"
                                                        HighlightedKey="{Binding HighlightedTrendNoticeNumber}"
                                                        RecommendationBandMin="{Binding RecommendationBandMin}"
                                                        RecommendationBandMax="{Binding RecommendationBandMax}"
                                                        RecommendationText="{Binding ConsolePipelineRecommendationText}" />
                    </Border>

                </Grid>
            </Border>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource PreviewCardBorderStyle}"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="동국 참여 낙찰공고" />
                                <TextBlock Margin="8,3,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           Text="{Binding IncrementalAwardSummaryText}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,14,0">
                            <TextBlock VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       Text="지역" />
                            <ComboBox Width="148"
                                      Height="38"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding SelectedRegion, Mode=TwoWay}">
                                <ComboBoxItem Content="전국" Tag="전국" />
                                <ComboBoxItem Content="경상북도" Tag="경북" />
                            </ComboBox>
                        </StackPanel>
                        <Button Width="138"
                                Height="48"
                                Margin="0,0,10,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="업데이트"
                                Command="{Binding CollectDataCommand}" />
                        <Button Width="138"
                                Height="48"
                                Margin="0,0,10,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Content="중지"
                                Command="{Binding StopCollectCommand}" />
                        <Button Width="156"
                                Height="48"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="차트 화면"
                                Click="OpenChartWindowClick" />

                        <Button x:Name="AutoCollectButton"
                                Width="0"
                                Height="0"
                                Margin="0"
                                Padding="0"
                                Visibility="Collapsed"
                                Click="ToggleAutoCollectClick" />
                    </StackPanel>

                </Grid>

                <Grid Grid.Row="2">
                    <DataGrid
                              ItemsSource="{Binding VisibleAwardNoticeItems}"
                              SelectedItem="{Binding SelectedAwardNoticeItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              RowHeaderWidth="0"
                              Background="#96FFFFFF"
                              RowBackground="#78FFFFFF"
                              AlternatingRowBackground="#54FFFFFF"
                              BorderBrush="{StaticResource PreviewFrameBrush}"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="개찰일" Binding="{Binding NoticeDate, StringFormat=yyyy-MM-dd HH:mm}" Width="1.05*" />
                            <DataGridTextColumn Header="공고번호" Binding="{Binding NoticeNumber}" Width="1.0*" />
                            <DataGridTextColumn Header="공고명" Binding="{Binding NoticeName}" Width="2.4*" />
                            <DataGridTextColumn Header="발주처" Binding="{Binding OrderingAgency}" Width="1.25*" />
                            <DataGridTextColumn Header="지역" Binding="{Binding RegionText}" Width="0.7*" />
                            <DataGridTextColumn Header="동국순위/낙찰" Binding="{Binding ParticipantCountText}" Width="1.25*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Style="{StaticResource PreviewCardBorderStyle}"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="{Binding CurrentFilterSummary}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="{Binding LastSyncText}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
