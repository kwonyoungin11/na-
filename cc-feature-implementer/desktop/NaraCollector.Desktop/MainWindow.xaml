<Window x:Class="NaraCollector.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:NaraCollector.Desktop.Controls"
        mc:Ignorable="d"
        Title="동국문화유산연구원 낙찰분석프로그램"
        Width="1880"
        Height="1060"
        MinWidth="1420"
        MinHeight="900"
        Background="{StaticResource GlassWindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource BodyFont}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource AccentGradientBrush}" />

        <Grid Grid.Row="1"
              Margin="20,16,20,18"
              Opacity="0">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             Duration="0:0:0.28" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource PreviewHeroBorderStyle}"
                    Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="3"
                            Margin="0,2,16,2"
                            CornerRadius="2"
                            Background="{StaticResource AccentGradientBrush}" />

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource EyebrowTextStyle}"
                                           Text="낙찰분석프로그램" />
                                <TextBlock Margin="0,2,0,0"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="동국문화유산연구원" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource InlineSummaryBorderStyle}"
                                    VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource MutedCaptionTextStyle}"
                                           Text="{Binding LoadStatusText}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="#ECFFFFFF"
                                BorderBrush="#E7C48C"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="10">
                            <controls:TrendLineChartControl x:Name="NoticeTrendChart"
                                                            ItemsSource="{Binding NoticeAdjustRateTrendPoints}"
                                                            SecondaryItemsSource="{Binding NoticeAwardReferenceTrendPoints}"
                                                            Height="228"
                                                            FooterCaption="동국 기초대비사정율"
                                                            PrimaryLegendText="동국문화재연구원 기초대비사정율"
                                                            SecondaryLegendText="같은 공고 실제 낙찰 사정율"
                                                            HighlightedKey="{Binding HighlightedTrendNoticeNumber}"
                                                            RecommendationBandMin="{Binding RecommendationBandMin}"
                                                            RecommendationBandMax="{Binding RecommendationBandMax}"
                                                            RecommendationText="{Binding ConsolePipelineRecommendationText}" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource PreviewCardBorderStyle}"
                    Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                           VerticalAlignment="Center"
                                           Text="동국 참여 낙찰공고" />
                                <Border Margin="10,0,0,0"
                                        Style="{StaticResource TagChipBorderStyle}"
                                        VerticalAlignment="Center">
                                    <TextBlock Foreground="{StaticResource AccentStrongBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding IncrementalAwardSummaryText}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       Text="지역" />
                            <ComboBox Width="148"
                                      Height="40"
                                      Margin="0,0,12,0"
                                      Style="{StaticResource RegionFilterComboBoxStyle}"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding SelectedRegion, Mode=TwoWay}"
                                      AutomationProperties.Name="지역">
                                <ComboBoxItem Content="전국" Tag="전국" />
                                <ComboBoxItem Content="경상북도" Tag="경북" />
                            </ComboBox>
                            <Button Width="124"
                                    Height="40"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="업데이트"
                                    Command="{Binding CollectDataCommand}"
                                    AutomationProperties.Name="업데이트" />
                            <Button Width="108"
                                    Height="40"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource StopCollectButtonStyle}"
                                    Content="중지"
                                    Command="{Binding StopCollectCommand}"
                                    AutomationProperties.Name="중지" />
                            <Button Width="132"
                                    Height="40"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="차트 화면"
                                    Click="OpenChartWindowClick"
                                    AutomationProperties.Name="차트 화면" />

                            <Button x:Name="AutoCollectButton"
                                    Width="0"
                                    Height="0"
                                    Margin="0"
                                    Padding="0"
                                    Visibility="Collapsed"
                                    Click="ToggleAutoCollectClick" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <DataGrid Style="{StaticResource AwardNoticeDataGridStyle}"
                                  ItemsSource="{Binding VisibleAwardNoticeItems}"
                                  SelectedItem="{Binding SelectedAwardNoticeItem, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  RowHeaderWidth="0"
                                  KeyboardNavigation.TabNavigation="Once">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="개찰일"
                                                    Binding="{Binding NoticeDate, StringFormat=yyyy-MM-dd HH:mm}"
                                                    Width="1.05*"
                                                    SortDirection="Descending"
                                                    ElementStyle="{StaticResource AwardNoticeMonoCellTextStyle}" />
                                <DataGridTextColumn Header="공고번호"
                                                    Binding="{Binding NoticeNumber}"
                                                    Width="1.0*"
                                                    ElementStyle="{StaticResource AwardNoticeMonoCellTextStyle}" />
                                <DataGridTextColumn Header="공고명"
                                                    Binding="{Binding NoticeName}"
                                                    Width="2.4*"
                                                    ElementStyle="{StaticResource AwardNoticeBodyCellTextStyle}" />
                                <DataGridTextColumn Header="발주처"
                                                    Binding="{Binding OrderingAgency}"
                                                    Width="1.25*"
                                                    ElementStyle="{StaticResource AwardNoticeBodyCellTextStyle}" />
                                <DataGridTextColumn Header="지역"
                                                    Binding="{Binding RegionText}"
                                                    Width="0.7*"
                                                    ElementStyle="{StaticResource AwardNoticeBodyCellTextStyle}" />
                                <DataGridTextColumn Header="동국순위/낙찰"
                                                    Binding="{Binding ParticipantCountText}"
                                                    Width="1.25*"
                                                    ElementStyle="{StaticResource AwardNoticeBodyCellTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Style="{StaticResource CollectDimmerBorderStyle}"
                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Panel.ZIndex="20">
                            <Border Style="{StaticResource CollectOverlayBorderStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EyebrowTextStyle}"
                                               Text="나라장터 낙찰 수집" />
                                    <TextBlock Margin="0,8,0,14"
                                               FontFamily="{StaticResource HeadingFont}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Text="{Binding LoadStatusText}" />
                                    <ProgressBar Style="{StaticResource CollectProgressBarStyle}"
                                                 Value="{Binding LoadProgress, Mode=OneWay}"
                                                 AutomationProperties.Name="수집 진행률" />
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Margin="0,14,0,0"
                    Style="{StaticResource StatusStripBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12"
                               Text="{Binding CurrentFilterSummary}"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="20,0,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"
                                   Text="{Binding LoadStatusText}"
                                   TextTrimming="CharacterEllipsis" />
                        <ProgressBar Width="132"
                                     Margin="12,0,0,0"
                                     Style="{StaticResource CollectProgressBarStyle}"
                                     Value="{Binding LoadProgress, Mode=OneWay}"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     AutomationProperties.Name="수집 진행률" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12"
                               Text="{Binding LastSyncText}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
